-- 7GUIs Task 7: Cells (Spreadsheet)
-- 26 columns (A-Z) x 100 rows (0-99), official-size grid.
-- Double-click edit, Enter commit, Escape cancel, blur exit, reactive formulas.

total_rows: 100
total_columns: 26
max_visible_row_count: 16
max_visible_column_count: 12

visible_row_count: BLOCK {
    available_rows: Terminal/rows() - 8

    available_rows < 1 |> WHEN {
        True => 1
        __ => available_rows > max_visible_row_count |> WHEN {
            True => max_visible_row_count
            __ => available_rows
        }
    }
}

visible_column_count: BLOCK {
    terminal_columns: Terminal/columns()

    terminal_columns >= 78 |> WHEN {
        True => 12
        __ => terminal_columns >= 72 |> WHEN {
            True => 11
            __ => terminal_columns >= 66 |> WHEN {
                True => 10
                __ => terminal_columns >= 60 |> WHEN {
                    True => 9
                    __ => terminal_columns >= 54 |> WHEN {
                        True => 8
                        __ => terminal_columns >= 48 |> WHEN {
                            True => 7
                            __ => terminal_columns >= 42 |> WHEN {
                                True => 6
                                __ => terminal_columns >= 36 |> WHEN {
                                    True => 5
                                    __ => terminal_columns >= 30 |> WHEN {
                                        True => 4
                                        __ => terminal_columns >= 24 |> WHEN {
                                            True => 3
                                            __ => terminal_columns >= 18 |> WHEN {
                                                True => 2
                                                __ => 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

FUNCTION max_row_start() {
    total_rows - visible_row_count
}

FUNCTION max_column_start() {
    total_columns - visible_column_count + 1
}

FUNCTION visible_row_numbers() {
    List/range(
        from: viewport_row_start
        to: viewport_row_start + visible_row_count - 1
    )
}

FUNCTION visible_columns() {
    List/range(
        from: viewport_column_start
        to: viewport_column_start + visible_column_count - 1
    )
}

FUNCTION latest_override_info(column, row, index) {
    index < 1 |> WHEN {
        True => [found: False, text: Text/empty()]

        __ => BLOCK {
            item: overrides |> List/get(index: index)

            item.row == row |> WHEN {
                True => item.column == column |> WHEN {
                    True => [found: True, text: item.text]
                    __ => latest_override_info(column: column, row: row, index: index - 1)
                }

                __ => latest_override_info(column: column, row: row, index: index - 1)
            }
        }
    }
}

FUNCTION cell_formula(column, row) {
    BLOCK {
        latest_override:
            latest_override_info(
                column: column
                row: row
                index: overrides |> List/count()
            )

        latest_override.found |> WHEN {
            True => latest_override.text
            __ => default_formula(column: column, row: row)
        }
    }
}

FUNCTION parse_column_letter(text) {
    text |> WHEN {
        TEXT { A } => 1
        TEXT { B } => 2
        TEXT { C } => 3
        TEXT { D } => 4
        TEXT { E } => 5
        TEXT { F } => 6
        TEXT { G } => 7
        TEXT { H } => 8
        TEXT { I } => 9
        TEXT { J } => 10
        TEXT { K } => 11
        TEXT { L } => 12
        TEXT { M } => 13
        TEXT { N } => 14
        TEXT { O } => 15
        TEXT { P } => 16
        TEXT { Q } => 17
        TEXT { R } => 18
        TEXT { S } => 19
        TEXT { T } => 20
        TEXT { U } => 21
        TEXT { V } => 22
        TEXT { W } => 23
        TEXT { X } => 24
        TEXT { Y } => 25
        TEXT { Z } => 26
        __ => 0
    }
}

FUNCTION number_or_zero(text) {
    BLOCK {
        trimmed_text: text |> Text/trim()

        is_integer_text(text: trimmed_text) |> WHEN {
            True =>
                trimmed_text
                |> Text/to_number()
                |> WHILE {
                    NaN => 0
                    number => number
                }

            __ => 0
        }
    }
}

FUNCTION number_or_minus_one(text) {
    BLOCK {
        trimmed_text: text |> Text/trim()

        is_integer_text(text: trimmed_text) |> WHEN {
            True =>
                trimmed_text
                |> Text/to_number()
                |> WHILE {
                    NaN => -1
                    number => number
                }

            __ => -1
        }
    }
}

FUNCTION is_digit_char(text) {
    text |> WHEN {
        TEXT { 0 } => True
        TEXT { 1 } => True
        TEXT { 2 } => True
        TEXT { 3 } => True
        TEXT { 4 } => True
        TEXT { 5 } => True
        TEXT { 6 } => True
        TEXT { 7 } => True
        TEXT { 8 } => True
        TEXT { 9 } => True
        __ => False
    }
}

FUNCTION all_digit_text(text, index) {
    BLOCK {
        text_length: text |> Text/length()

        index >= text_length |> WHEN {
            True => True

            __ => BLOCK {
                current_char: text |> Text/substring(start: index, length: 1)
                is_digit_char(text: current_char) |> WHEN {
                    True => all_digit_text(text: text, index: index + 1)
                    __ => False
                }
            }
        }
    }
}

FUNCTION is_integer_text(text) {
    BLOCK {
        trimmed_text: text |> Text/trim()
        text_length: trimmed_text |> Text/length()

        text_length == 0 |> WHEN {
            True => False

            __ => BLOCK {
                first_char: trimmed_text |> Text/substring(start: 0, length: 1)

                first_char == TEXT { - } |> WHEN {
                    True => text_length == 1 |> WHEN {
                        True => False
                        __ =>
                            all_digit_text(
                                text: trimmed_text |> Text/substring(start: 1, length: text_length - 1)
                                index: 0
                            )
                    }

                    __ => all_digit_text(text: trimmed_text, index: 0)
                }
            }
        }
    }
}

FUNCTION is_number_text(text) {
    is_integer_text(text: text)
}

FUNCTION find_index_or_minus_one(text, search) {
    text
    |> Text/find(search: search)
    |> WHILE {
        NaN => -1
        index => index
    }
}

FUNCTION min_number(a, b) {
    a <= b |> WHEN {
        True => a
        __ => b
    }
}

FUNCTION max_number(a, b) {
    a >= b |> WHEN {
        True => a
        __ => b
    }
}

FUNCTION top_level_separator_index(text, separator, index, depth) {
    BLOCK {
        text_length: text |> Text/length()

        index >= text_length |> WHEN {
            True => -1

            __ => BLOCK {
                current_char: text |> Text/substring(start: index, length: 1)

                current_char == TEXT { ( } |> WHEN {
                    True =>
                        top_level_separator_index(
                            text: text
                            separator: separator
                            index: index + 1
                            depth: depth + 1
                        )

                    __ => current_char == TEXT { ) } |> WHEN {
                        True =>
                            top_level_separator_index(
                                text: text
                                separator: separator
                                index: index + 1
                                depth: depth - 1
                            )

                        __ => current_char == separator |> WHEN {
                            True => depth == 0 |> WHEN {
                                True => index
                                __ =>
                                    top_level_separator_index(
                                        text: text
                                        separator: separator
                                        index: index + 1
                                        depth: depth
                                    )
                            }

                            __ =>
                                top_level_separator_index(
                                    text: text
                                    separator: separator
                                    index: index + 1
                                    depth: depth
                                )
                        }
                    }
                }
            }
        }
    }
}

FUNCTION reference_info(ref_text) {
    BLOCK {
        trimmed_ref: ref_text |> Text/trim()
        ref_length: trimmed_ref |> Text/length()

        ref_length < 2 |> WHEN {
            True => [valid: False, column: 0, row: 0]

            __ => ref_length > 3 |> WHEN {
                True => [valid: False, column: 0, row: 0]

                __ => BLOCK {
                    column_text: trimmed_ref |> Text/substring(start: 0, length: 1)
                    row_text: trimmed_ref |> Text/substring(start: 1, length: ref_length - 1)
                    row_length: row_text |> Text/length()
                    column: parse_column_letter(text: column_text)
                    row_number: number_or_minus_one(text: row_text)

                    [
                        valid:
                            (column >= 1 |> WHEN {
                                True => column <= 26
                                __ => False
                            })
                            |> Bool/and(that:
                                row_length == 1 |> WHEN {
                                    True => is_number_text(text: row_text) |> WHEN {
                                        True => row_number >= 0 |> WHEN {
                                            True => row_number <= 9
                                            __ => False
                                        }
                                        __ => False
                                    }

                                    __ => row_length == 2 |> WHEN {
                                        True => is_number_text(text: row_text) |> WHEN {
                                            True => row_text |> Text/starts_with(prefix: TEXT { 0 }) |> WHEN {
                                                True => False
                                                __ => row_number >= 10 |> WHEN {
                                                    True => row_number <= 99
                                                    __ => False
                                                }
                                            }
                                            __ => False
                                        }

                                        __ => False
                                    }
                                }
                            )
                        column: column
                        row: row_number
                    ]
                }
            }
        }
    }
}

FUNCTION range_info(range_text) {
    BLOCK {
        trimmed_range: range_text |> Text/trim()
        range_length: trimmed_range |> Text/length()
        colon_index: find_index_or_minus_one(text: trimmed_range, search: TEXT { : })

        colon_index < 1 |> WHEN {
            True => [valid: False, start_column: 0, start_row: 0, end_column: 0, end_row: 0]

            __ => colon_index >= range_length - 1 |> WHEN {
                True => [valid: False, start_column: 0, start_row: 0, end_column: 0, end_row: 0]

                __ => BLOCK {
                    start_ref: trimmed_range |> Text/substring(start: 0, length: colon_index)
                    end_ref:
                        trimmed_range
                        |> Text/substring(start: colon_index + 1, length: range_length - colon_index - 1)

                    start_info: reference_info(ref_text: start_ref)
                    end_info: reference_info(ref_text: end_ref)
                    valid: start_info.valid |> Bool/and(that: end_info.valid)

                    [
                        valid: valid
                        start_column: min_number(a: start_info.column, b: end_info.column)
                        start_row: min_number(a: start_info.row, b: end_info.row)
                        end_column: max_number(a: start_info.column, b: end_info.column)
                        end_row: max_number(a: start_info.row, b: end_info.row)
                    ]
                }
            }
        }
    }
}

FUNCTION cell_stack_key(column, row) {
    row * 100 + column
}

FUNCTION stack_contains(stack, cell_key) {
    stack |> List/any(item, if: item == cell_key)
}

FUNCTION compute_cell_number(column, row, stack) {
    BLOCK {
        cell_key: cell_stack_key(column: column, row: row)

        stack_contains(stack: stack, cell_key: cell_key) |> WHEN {
            True => 0

            __ => compute_formula_number(
                formula_text: cell_formula(column: column, row: row)
                stack: stack |> List/append(item: cell_key)
            )
        }
    }
}

FUNCTION rectangle_sum(start_column, current_column, current_row, end_column, end_row, stack) {
    current_row > end_row |> WHEN {
        True => 0

        __ => current_column > end_column |> WHEN {
            True => rectangle_sum(
                start_column: start_column
                current_column: start_column
                current_row: current_row + 1
                end_column: end_column
                end_row: end_row
                stack: stack
            )

            __ =>
                compute_cell_number(
                    column: current_column
                    row: current_row
                    stack: stack
                )
                + rectangle_sum(
                    start_column: start_column
                    current_column: current_column + 1
                    current_row: current_row
                    end_column: end_column
                    end_row: end_row
                    stack: stack
                )
        }
    }
}

FUNCTION rectangle_prod(start_column, current_column, current_row, end_column, end_row, stack) {
    current_row > end_row |> WHEN {
        True => 1

        __ => current_column > end_column |> WHEN {
            True => rectangle_prod(
                start_column: start_column
                current_column: start_column
                current_row: current_row + 1
                end_column: end_column
                end_row: end_row
                stack: stack
            )

            __ =>
                compute_cell_number(
                    column: current_column
                    row: current_row
                    stack: stack
                )
                * rectangle_prod(
                    start_column: start_column
                    current_column: current_column + 1
                    current_row: current_row
                    end_column: end_column
                    end_row: end_row
                    stack: stack
                )
        }
    }
}

FUNCTION range_sum_value(range_text, stack) {
    BLOCK {
        info: range_info(range_text: range_text)

        info.valid |> WHEN {
            True => rectangle_sum(
                start_column: info.start_column
                current_column: info.start_column
                current_row: info.start_row
                end_column: info.end_column
                end_row: info.end_row
                stack: stack
            )

            __ => 0
        }
    }
}

FUNCTION range_prod_value(range_text, stack) {
    BLOCK {
        info: range_info(range_text: range_text)

        info.valid |> WHEN {
            True => rectangle_prod(
                start_column: info.start_column
                current_column: info.start_column
                current_row: info.start_row
                end_column: info.end_column
                end_row: info.end_row
                stack: stack
            )

            __ => 1
        }
    }
}

FUNCTION binary_args_info(args_text) {
    BLOCK {
        trimmed_args: args_text |> Text/trim()
        args_length: trimmed_args |> Text/length()
        comma_index:
            top_level_separator_index(
                text: trimmed_args
                separator: TEXT { , }
                index: 0
                depth: 0
            )

        comma_index < 0 |> WHEN {
            True => [valid: False, left: Text/empty(), right: Text/empty()]

            __ => BLOCK {
                left_text: trimmed_args |> Text/substring(start: 0, length: comma_index) |> Text/trim()
                right_text:
                    trimmed_args
                    |> Text/substring(start: comma_index + 1, length: args_length - comma_index - 1)
                    |> Text/trim()

                second_comma_index:
                    top_level_separator_index(
                        text: right_text
                        separator: TEXT { , }
                        index: 0
                        depth: 0
                    )

                [
                    valid:
                        second_comma_index < 0
                        |> Bool/and(that: left_text |> Text/is_not_empty())
                        |> Bool/and(that: right_text |> Text/is_not_empty())
                    left: left_text
                    right: right_text
                ]
            }
        }
    }
}

FUNCTION scalar_expression_value(text, stack) {
    BLOCK {
        trimmed_text: text |> Text/trim()
        ref: reference_info(ref_text: trimmed_text)
        range: range_info(range_text: trimmed_text)
        text_length: trimmed_text |> Text/length()
        open_paren_index: find_index_or_minus_one(text: trimmed_text, search: TEXT { ( })

        trimmed_text |> Text/is_empty() |> WHEN {
            True => 0

            __ => is_number_text(text: trimmed_text) |> WHEN {
                True => number_or_zero(text: trimmed_text)

                __ => ref.valid |> WHEN {
                    True => compute_cell_number(
                        column: ref.column
                        row: ref.row
                        stack: stack
                    )

                    __ => range.valid |> WHEN {
                        True => range_sum_value(range_text: trimmed_text, stack: stack)

                        __ => open_paren_index > 0 |> WHEN {
                            True => BLOCK {
                                last_char:
                                    trimmed_text
                                    |> Text/substring(start: text_length - 1, length: 1)

                                last_char == TEXT { ) } |> WHEN {
                                    True => BLOCK {
                                        function_name:
                                            trimmed_text
                                            |> Text/substring(start: 0, length: open_paren_index)
                                            |> Text/trim()

                                        args_text:
                                            trimmed_text
                                            |> Text/substring(
                                                start: open_paren_index + 1
                                                length: text_length - open_paren_index - 2
                                            )

                                        function_name |> WHEN {
                                            TEXT { add } => BLOCK {
                                                args: binary_args_info(args_text: args_text)
                                                args.valid |> WHEN {
                                                    True =>
                                                        scalar_expression_value(text: args.left, stack: stack)
                                                        + scalar_expression_value(text: args.right, stack: stack)
                                                    __ => 0
                                                }
                                            }

                                            TEXT { sub } => BLOCK {
                                                args: binary_args_info(args_text: args_text)
                                                args.valid |> WHEN {
                                                    True =>
                                                        scalar_expression_value(text: args.left, stack: stack)
                                                        - scalar_expression_value(text: args.right, stack: stack)
                                                    __ => 0
                                                }
                                            }

                                            TEXT { mul } => BLOCK {
                                                args: binary_args_info(args_text: args_text)
                                                args.valid |> WHEN {
                                                    True =>
                                                        scalar_expression_value(text: args.left, stack: stack)
                                                        * scalar_expression_value(text: args.right, stack: stack)
                                                    __ => 0
                                                }
                                            }

                                            TEXT { div } => BLOCK {
                                                args: binary_args_info(args_text: args_text)
                                                args.valid |> WHEN {
                                                    True => BLOCK {
                                                        divisor: scalar_expression_value(text: args.right, stack: stack)
                                                        divisor == 0 |> WHEN {
                                                            True => 0
                                                            __ => scalar_expression_value(text: args.left, stack: stack) / divisor
                                                        }
                                                    }
                                                    __ => 0
                                                }
                                            }

                                            TEXT { mod } => BLOCK {
                                                args: binary_args_info(args_text: args_text)
                                                args.valid |> WHEN {
                                                    True => BLOCK {
                                                        divisor: scalar_expression_value(text: args.right, stack: stack)
                                                        divisor == 0 |> WHEN {
                                                            True => 0
                                                            __ => scalar_expression_value(text: args.left, stack: stack) % divisor
                                                        }
                                                    }
                                                    __ => 0
                                                }
                                            }

                                            TEXT { sum } => sum_args(args_text: args_text, stack: stack)
                                            TEXT { prod } => prod_args(args_text: args_text, stack: stack)
                                            __ => 0
                                        }
                                    }

                                    __ => 0
                                }
                            }

                            __ => 0
                        }
                    }
                }
            }
        }
    }
}

FUNCTION sum_arg_value(arg_text, stack) {
    BLOCK {
        range: range_info(range_text: arg_text)

        range.valid |> WHEN {
            True => range_sum_value(range_text: arg_text, stack: stack)
            __ => scalar_expression_value(text: arg_text, stack: stack)
        }
    }
}

FUNCTION prod_arg_value(arg_text, stack) {
    BLOCK {
        range: range_info(range_text: arg_text)

        range.valid |> WHEN {
            True => range_prod_value(range_text: arg_text, stack: stack)
            __ => scalar_expression_value(text: arg_text, stack: stack)
        }
    }
}

FUNCTION sum_args(args_text, stack) {
    BLOCK {
        trimmed_args: args_text |> Text/trim()
        args_length: trimmed_args |> Text/length()
        comma_index:
            top_level_separator_index(
                text: trimmed_args
                separator: TEXT { , }
                index: 0
                depth: 0
            )

        trimmed_args |> Text/is_empty() |> WHEN {
            True => 0

            __ => comma_index < 0 |> WHEN {
                True => sum_arg_value(arg_text: trimmed_args, stack: stack)

                __ => BLOCK {
                    left_arg: trimmed_args |> Text/substring(start: 0, length: comma_index)
                    right_args:
                        trimmed_args
                        |> Text/substring(start: comma_index + 1, length: args_length - comma_index - 1)

                    sum_arg_value(arg_text: left_arg, stack: stack)
                    + sum_args(args_text: right_args, stack: stack)
                }
            }
        }
    }
}

FUNCTION prod_args(args_text, stack) {
    BLOCK {
        trimmed_args: args_text |> Text/trim()
        args_length: trimmed_args |> Text/length()
        comma_index:
            top_level_separator_index(
                text: trimmed_args
                separator: TEXT { , }
                index: 0
                depth: 0
            )

        trimmed_args |> Text/is_empty() |> WHEN {
            True => 1

            __ => comma_index < 0 |> WHEN {
                True => prod_arg_value(arg_text: trimmed_args, stack: stack)

                __ => BLOCK {
                    left_arg: trimmed_args |> Text/substring(start: 0, length: comma_index)
                    right_args:
                        trimmed_args
                        |> Text/substring(start: comma_index + 1, length: args_length - comma_index - 1)

                    prod_arg_value(arg_text: left_arg, stack: stack)
                    * prod_args(args_text: right_args, stack: stack)
                }
            }
        }
    }
}

FUNCTION compute_formula_number(formula_text, stack) {
    formula_text
    |> Text/starts_with(prefix: TEXT { = })
    |> WHILE {
        False => number_or_zero(text: formula_text)

        __ => BLOCK {
            formula_length: formula_text |> Text/length()

            expression:
                formula_text
                |> Text/substring(start: 1, length: formula_length - 1)

            scalar_expression_value(text: expression, stack: stack)
        }
    }
}

FUNCTION default_formula(column, row) {
    column == 1 |> WHEN {
        True => row |> WHEN {
            0 => TEXT { 5 }
            1 => TEXT { 10 }
            2 => TEXT { 15 }
            __ => Text/empty()
        }

        __ => column == 2 |> WHEN {
            True => row |> WHEN {
                0 => TEXT { =add(A0, A1) }
                1 => TEXT { =sub(A2, A0) }
                2 => TEXT { =mul(A0, 3) }
                __ => Text/empty()
            }

            __ => column == 3 |> WHEN {
                True => row |> WHEN {
                    0 => TEXT { =sum(A0:A2) }
                    1 => TEXT { =prod(1, 2, 3) }
                    2 => TEXT { =div(A2, A0) }
                    __ => Text/empty()
                }

                __ => column == 4 |> WHEN {
                    True => row |> WHEN {
                        0 => TEXT { =mod(A2, 4) }
                        1 => TEXT { =sum(A0:B2) }
                        2 => TEXT { =A0:B2 }
                        __ => Text/empty()
                    }

                    __ => column == 5 |> WHEN {
                        True => row |> WHEN {
                            0 => TEXT { note }
                            1 => TEXT { =add(E0, 2) }
                            __ => Text/empty()
                        }

                        __ => Text/empty()
                    }
                }
            }
        }
    }
}

FUNCTION is_editing_cell(column, row) {
    editing_active |> WHEN {
        True => focused_row == row |> WHEN {
            True => focused_column == column
            __ => False
        }

        __ => False
    }
}

FUNCTION column_header(column_index) {
    column_index |> WHEN {
        1 => TEXT { A }
        2 => TEXT { B }
        3 => TEXT { C }
        4 => TEXT { D }
        5 => TEXT { E }
        6 => TEXT { F }
        7 => TEXT { G }
        8 => TEXT { H }
        9 => TEXT { I }
        10 => TEXT { J }
        11 => TEXT { K }
        12 => TEXT { L }
        13 => TEXT { M }
        14 => TEXT { N }
        15 => TEXT { O }
        16 => TEXT { P }
        17 => TEXT { Q }
        18 => TEXT { R }
        19 => TEXT { S }
        20 => TEXT { T }
        21 => TEXT { U }
        22 => TEXT { V }
        23 => TEXT { W }
        24 => TEXT { X }
        25 => TEXT { Y }
        26 => TEXT { Z }
        __ => TEXT { ? }
    }
}

FUNCTION single_space() {
    Text/space()
}

FUNCTION spaces(count) {
    single_space() |> Text/repeat(times: count)
}

FUNCTION clip_text(text, max_length) {
    BLOCK {
        text_length: text |> Text/length()

        text_length > max_length |> WHEN {
            True => text |> Text/substring(start: 0, length: max_length)
            False => text
        }
    }
}

FUNCTION fixed_cell_char(text, text_length, index) {
    index < text_length |> WHEN {
        True => text |> Text/substring(start: index, length: 1)
        False => single_space()
    }
}

FUNCTION grid_cell_content(text) {
    BLOCK {
        content_width: 4

        clipped_text: clip_text(text: text, max_length: content_width)
        clipped_length: clipped_text |> Text/length()
        char_0: fixed_cell_char(text: clipped_text, text_length: clipped_length, index: 0)
        char_1: fixed_cell_char(text: clipped_text, text_length: clipped_length, index: 1)
        char_2: fixed_cell_char(text: clipped_text, text_length: clipped_length, index: 2)
        char_3: fixed_cell_char(text: clipped_text, text_length: clipped_length, index: 3)

        TEXT {
            {char_0}{char_1}{char_2}{char_3}
        }
    }
}

FUNCTION grid_cell_box(text, is_selected, is_hovered) {
    BLOCK {
        content: grid_cell_content(text: text)

        is_selected |> WHEN {
            True => is_hovered |> WHEN {
                True => TEXT { <{content}> }
                False => TEXT { [{content}] }
            }

            False => is_hovered |> WHEN {
                True => TEXT { *{content}* }
                False => TEXT { |{content}| }
            }
        }
    }
}

FUNCTION row_label_box(row_number, is_selected) {
    BLOCK {
        row_text: TEXT { {row_number} }
        content: grid_cell_content(text: row_text)
        is_selected |> WHEN {
            True => TEXT { [{content}] }
            False => TEXT { |{content}| }
        }
    }
}

FUNCTION cell_name(column, row) {
    BLOCK {
        column_text: column_header(column_index: column)
        TEXT { {column_text}{row} }
    }
}

FUNCTION pointer_status() {
    hovered_active |> WHEN {
        True => BLOCK {
            hovered_text: cell_name(column: hovered_column, row: hovered_row)
            TEXT { Hover {hovered_text} }
        }
        False => TEXT { Hover none }
    }
}

FUNCTION editing_status() {
    editing_active |> WHEN {
        True => BLOCK {
            editing_cell: cell_name(column: focused_column, row: focused_row)
            TEXT { Editing {editing_cell} }
        }
        False => TEXT { Ready }
    }
}

FUNCTION current_formula_bar_text() {
    BLOCK {
        focused_formula: cell_formula(column: focused_column, row: focused_row)

        editing_active |> WHEN {
            True => editing_dirty |> WHEN {
                True => editing_text
                __ => focused_formula
            }

            __ => focused_formula
        }
    }
}

FUNCTION empty_corner_box() {
    grid_cell_box(
        text: Text/empty()
        is_selected: False
        is_hovered: False
    )
}

FUNCTION cell_display_text(formula_text, display_value) {
    formula_text
    |> Text/is_empty()
    |> WHILE {
        True => Text/empty()
        __ => formula_text |> Text/starts_with(prefix: TEXT { = }) |> WHEN {
            True => TEXT { {display_value} }
            __ => formula_text
        }
    }
}

FUNCTION is_selected_cell(column, row) {
    focused_row == row |> WHEN {
        True => focused_column == column
        __ => False
    }
}

FUNCTION is_selected_row(row_number) {
    focused_row == row_number
}

FUNCTION is_hovered_cell(column, row) {
    hovered_active |> WHEN {
        True => hovered_row == row |> WHEN {
            True => hovered_column == column
            __ => False
        }

        __ => False
    }
}

FUNCTION make_cell_element(column, row) {
    BLOCK {
        formula_text: cell_formula(column: column, row: row)
        display_value: formula_text |> Text/starts_with(prefix: TEXT { = }) |> WHEN {
            True => compute_cell_number(column: column, row: row, stack: LIST { cell_stack_key(column: column, row: row) })
            __ => 0
        }
        is_editing: is_editing_cell(column: column, row: row)
        is_selected: is_selected_cell(column: column, row: row)
        is_hovered: is_hovered_cell(column: column, row: row)
        display_container: [event: [hovered: SOURCE]]
        display_element: [event: [click: SOURCE, double_click: SOURCE]]
        editing_element: [event: [change: SOURCE, key_down: SOURCE, blur: SOURCE]]

        select_started_link:
            display_element.event.click
            |> THEN {
                [
                    row: row
                    column: column
                ]
            }
            |> SOURCE { event_ports.select_cell }

        edit_started_link:
            display_element.event.double_click
            |> THEN {
                [
                    row: row
                    column: column
                ]
            }
            |> SOURCE { event_ports.edit_started }

        edit_selected_again_link:
            display_element.event.click
            |> THEN {
                focused_row == row |> WHEN {
                    True => focused_column == column |> WHEN {
                        True => [
                            row: row
                            column: column
                        ]
                        __ => SKIP
                    }
                    __ => SKIP
                }
            }
            |> SOURCE { event_ports.edit_started }

        edit_changed_link:
            editing_element.event.change
            |> THEN { editing_element.event.change.text }
            |> SOURCE { event_ports.edit_text_event }

        edit_transition_link:
            editing_element.event.key_down.key
            |> WHEN {
                Enter => [
                    commit: True
                    row: row
                    column: column
                    committed_text: editing_element.event.key_down.text
                    active: False
                    text: Text/empty()
                    dirty: False
                ]
                Escape => [
                    commit: False
                    row: row
                    column: column
                    committed_text: Text/empty()
                    active: False
                    text: Text/empty()
                    dirty: False
                ]
                __ => SKIP
            }
            |> SOURCE { event_ports.edit_transition }

        edit_blurred_link:
            editing_element.event.blur
            |> THEN {
                [
                    commit: False
                    row: row
                    column: column
                    committed_text: Text/empty()
                    active: False
                    text: Text/empty()
                    dirty: False
                ]
            }
            |> SOURCE { event_ports.edit_transition }

        hovered_cell_link:
            display_container.event.hovered
            |> THEN {
                [
                    row: row
                    column: column
                    hovered: display_container.event.hovered
                ]
            }
            |> SOURCE { event_ports.hovered_cell }

        is_editing |> WHILE {
            True => Element/text_input(
                element: editing_element

                style: [
                    width: 48
                    height: 26
                    background: [color: Oklch [lightness: 1]]
                    font: [color: Oklch [lightness: 0.12]]
                ]

                label: Hidden [text: TEXT { cell }]
                text: editing_dirty |> WHEN {
                    True => editing_text
                    False => cell_formula(column: focused_column, row: focused_row)
                }
                placeholder: [text: Text/empty()]
                focus: True
            )

            False => Element/stripe(
                element: display_container
                direction: Row
                gap: 0
                style: []

                items: LIST {
                    Element/label(
                        element: display_element

                        style: [
                            width: 48
                            height: 26
                            background: [color: Oklch [lightness: 1]]
                            font: [color: Oklch [lightness: 0.12]]
                        ]

                        label: grid_cell_box(
                            text: cell_display_text(formula_text: formula_text, display_value: display_value)
                            is_selected: is_selected
                            is_hovered: is_hovered
                        )
                    )
                }
            )
        }
    }
}

FUNCTION make_row(row_number, visible_columns_list) {
    Element/stripe(
        element: []
        direction: Row
        gap: 0
        style: []

        items: LIST {
            Element/label(
                element: []

                style: [
                    width: 48
                    height: 26
                    background: [color: Oklch [lightness: 0.92]]
                    font: [weight: Bold, color: Oklch [lightness: 0.22]]
                ]

                label: row_label_box(
                    row_number: row_number
                    is_selected: is_selected_row(row_number: row_number)
                )
            )

            Element/stripe(
                element: []
                direction: Row
                gap: 0
                style: []
                items: visible_columns_list |> List/map(column, new: make_cell_element(column: column, row: row_number))
            )
        }
    )
}

terminal: Terminal/new(
    root: BLOCK {
        visible_columns_list: visible_columns()
        visible_row_numbers_list: visible_row_numbers()

        Element/stripe(
            element: [
                terminal: [
                    bindings: LIST {
                        [
                            keys: LIST { TEXT { Up } }
                            link: event_ports.move_up
                            when: editing_active |> Bool/not()
                            label: TEXT { move up }
                        ]
                        [
                            keys: LIST { TEXT { Down } }
                            link: event_ports.move_down
                            when: editing_active |> Bool/not()
                            label: TEXT { move down }
                        ]
                        [
                            keys: LIST { TEXT { Left } }
                            link: event_ports.move_left
                            when: editing_active |> Bool/not()
                            label: TEXT { move left }
                        ]
                        [
                            keys: LIST { TEXT { Right } }
                            link: event_ports.move_right
                            when: editing_active |> Bool/not()
                            label: TEXT { move right }
                        ]
                        [
                            keys: LIST { TEXT { Enter } }
                            link: event_ports.edit_selected
                            when: editing_active |> Bool/not()
                            label: TEXT { edit }
                        ]
                    }
                ]
            ]
            direction: Column
            gap: 0

            style: [
                padding: 20
                background: [color: Oklch [lightness: 0.97]]
                font: [color: Oklch [lightness: 0.12]]
            ]

            items: LIST {
                Element/label(
                    element: []
                    style: [font: [size: 22, weight: Bold, color: Oklch [lightness: 0.18]]]
                    label: TEXT { Cells }
                )

                Element/label(
                    element: []
                    style: []
                    label: TEXT { Arrows or click move selection, Enter edits, double-click edits, hover highlights }
                )

                BLOCK {
                    focus_text: cell_name(column: focused_column, row: focused_row)
                    hover_text: pointer_status()
                    mode_text: editing_status()
                    gap: single_space()

                    Element/label(
                        element: []
                        style: []
                        label: TEXT {
                            Focus {focus_text}{gap}{hover_text}{gap}{mode_text}
                        }
                    )
                }

                BLOCK {
                    focus_text: cell_name(column: focused_column, row: focused_row)
                    formula_text: current_formula_bar_text()
                    gap: single_space()

                    Element/label(
                        element: []

                        style: [
                            width: 720
                            height: 26
                            padding: [left: 8, right: 8]
                            background: [color: Oklch [lightness: 0.93]]
                            font: [color: Oklch [lightness: 0.18]]
                        ]

                        label:
                            LIST {
                                TEXT { Formula }
                                gap
                                focus_text
                                TEXT { : }
                                gap
                                formula_text
                            }
                            |> Text/join()
                    )
                }

                Element/stripe(
                    element: []
                    direction: Row
                    gap: 0
                    style: []

                    items: LIST {
                        Element/label(
                            element: []

                    style: [
                        width: 48
                        height: 26
                        background: [color: Oklch [lightness: 0.92]]
                    ]

                            label: empty_corner_box()
                        )

                        Element/stripe(
                            element: []
                            direction: Row
                            gap: 0
                            style: []

                            items: visible_columns_list |> List/map(column, new: Element/label(
                                element: []

                                style: [
                                    width: 48
                                    height: 26
                                    background: [color: Oklch [lightness: 0.92]]
                                    font: [weight: Bold, color: Oklch [lightness: 0.22]]
                                ]

                                label: grid_cell_box(
                                    text: column_header(column_index: column)
                                    is_selected: focused_column == column
                                    is_hovered: False
                                )
                            ))
                        )
                    }
                )

                Element/stripe(
                    element: []
                    direction: Column
                    gap: 0
                    style: [height: 500]

                    items: visible_row_numbers_list |> List/map(
                        row_number
                        new: make_row(row_number: row_number, visible_columns_list: visible_columns_list)
                    )
                )
            }
        )
    }

    loop: None
)

event_ports: [
    move_up: SOURCE
    move_down: SOURCE
    move_left: SOURCE
    move_right: SOURCE
    select_cell: SOURCE
    edit_selected: SOURCE
    edit_started: SOURCE
    hovered_cell: SOURCE
    edit_text_event: SOURCE
    edit_transition: SOURCE
]

focused_row: 0 |> HOLD state {
    event_ports.move_up |> THEN {
        state == 0 |> WHEN {
            True => 0
            False => state - 1
        }
    }
    event_ports.move_down |> THEN {
        state == 99 |> WHEN {
            True => 99
            False => state + 1
        }
    }
    event_ports.select_cell.row
    event_ports.edit_started.row
}

focused_column: 1 |> HOLD state {
    event_ports.move_left |> THEN {
        state == 1 |> WHEN {
            True => 1
            False => state - 1
        }
    }
    event_ports.move_right |> THEN {
        state == 26 |> WHEN {
            True => 26
            False => state + 1
        }
    }
    event_ports.select_cell.column
    event_ports.edit_started.column
}

hovered_row: 0 |> HOLD state {
    event_ports.hovered_cell.row
}

hovered_column: 0 |> HOLD state {
    event_ports.hovered_cell.column
}

hovered_active: False |> HOLD state {
    event_ports.hovered_cell.hovered
}

viewport_row_start: 0 |> HOLD state {
    event_ports.move_up |> THEN {
        focused_row == 0 |> WHEN {
            True => state
            __ => focused_row - 1 < state |> WHEN {
                True => state == 0 |> WHEN {
                    True => 0
                    __ => state - 1
                }
                __ => state
            }
        }
    }
    event_ports.move_down |> THEN {
        focused_row == 99 |> WHEN {
            True => state
            __ => focused_row + 1 >= state + visible_row_count |> WHEN {
                True => state >= max_row_start() |> WHEN {
                    True => max_row_start()
                    __ => state + 1
                }
                __ => state
            }
        }
    }
    event_ports.select_cell.row |> THEN {
        event_ports.select_cell.row < state |> WHEN {
            True => event_ports.select_cell.row
            __ => event_ports.select_cell.row >= state + visible_row_count |> WHEN {
                True => event_ports.select_cell.row - visible_row_count + 1 > max_row_start() |> WHEN {
                    True => max_row_start()
                    __ => event_ports.select_cell.row - visible_row_count + 1
                }
                __ => state
            }
        }
    }
    event_ports.edit_started.row |> THEN {
        event_ports.edit_started.row < state |> WHEN {
            True => event_ports.edit_started.row
            __ => event_ports.edit_started.row >= state + visible_row_count |> WHEN {
                True => event_ports.edit_started.row - visible_row_count + 1 > max_row_start() |> WHEN {
                    True => max_row_start()
                    __ => event_ports.edit_started.row - visible_row_count + 1
                }
                __ => state
            }
        }
    }
}

viewport_column_start: 1 |> HOLD state {
    event_ports.move_left |> THEN {
        focused_column == 1 |> WHEN {
            True => state
            __ => focused_column - 1 < state |> WHEN {
                True => state == 1 |> WHEN {
                    True => 1
                    __ => state - 1
                }
                __ => state
            }
        }
    }
    event_ports.move_right |> THEN {
        focused_column == 26 |> WHEN {
            True => state
            __ => focused_column + 1 >= state + visible_column_count |> WHEN {
                True => state >= max_column_start() |> WHEN {
                    True => max_column_start()
                    __ => state + 1
                }
                __ => state
            }
        }
    }
    event_ports.select_cell.column |> THEN {
        event_ports.select_cell.column < state |> WHEN {
            True => event_ports.select_cell.column
            __ => event_ports.select_cell.column >= state + visible_column_count |> WHEN {
                True => event_ports.select_cell.column - visible_column_count + 1 > max_column_start() |> WHEN {
                    True => max_column_start()
                    __ => event_ports.select_cell.column - visible_column_count + 1
                }
                __ => state
            }
        }
    }
    event_ports.edit_started.column |> THEN {
        event_ports.edit_started.column < state |> WHEN {
            True => event_ports.edit_started.column
            __ => event_ports.edit_started.column >= state + visible_column_count |> WHEN {
                True => event_ports.edit_started.column - visible_column_count + 1 > max_column_start() |> WHEN {
                    True => max_column_start()
                    __ => event_ports.edit_started.column - visible_column_count + 1
                }
                __ => state
            }
        }
    }
}

editing_text: Text/empty() |> HOLD state {
    event_ports.edit_text_event
    event_ports.edit_transition.text
}

editing_active: False |> HOLD state {
    event_ports.edit_started |> THEN { True }
    event_ports.edit_selected |> THEN { True }
    event_ports.edit_transition.active
}

editing_dirty: False |> HOLD state {
    event_ports.edit_started |> THEN { False }
    event_ports.edit_selected |> THEN { False }
    event_ports.edit_text_event |> THEN { True }
    event_ports.edit_transition.dirty
}

overrides: LIST {} |> HOLD state {
    event_ports.edit_transition.commit |> WHEN {
        True => event_ports.edit_transition |> THEN {
            BLOCK {
                trimmed_state:
                    state
                    |> List/retain(item, if:
                        item.row == event_ports.edit_transition.row
                        |> WHEN {
                            True => item.column == event_ports.edit_transition.column |> WHEN {
                                True => False
                                __ => True
                            }

                            __ => True
                        }
                    )

                committed_default_text: default_formula(
                    column: event_ports.edit_transition.column
                    row: event_ports.edit_transition.row
                )

                event_ports.edit_transition.committed_text == committed_default_text |> WHEN {
                    True => trimmed_state

                    __ => trimmed_state |> List/append(
                        item: [
                            row: event_ports.edit_transition.row
                            column: event_ports.edit_transition.column
                            text: event_ports.edit_transition.committed_text
                        ]
                    )
                }
            }
        }
        __ => SKIP
    }
}
