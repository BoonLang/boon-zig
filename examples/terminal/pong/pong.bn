store: [
    --- constants ---

    board: [
        top_row: 0
        bottom_row: 6
        left_goal_x: 0
        right_goal_x: 16
        left_paddle_x: 1
        right_paddle_x: 15
    ]

    paddle: [
        min_center: 1
        max_center: 5
        start_center: 3
    ]

    serve: [
        x: 8
        y: 3
        dx: 1
        dy: 1
    ]

    border_width: board.right_goal_x + 7

    --- links ---

    elements: [
        up_button: LINK
        down_button: LINK
        serve_button: LINK
        restart_button: LINK
        tick_button: LINK
    ]

    --- states ---

    player_paddle: store.paddle.start_center |> HOLD player_paddle {
        store.elements.up_button.event.press |> THEN {
            player_paddle |> WHEN {
                store.paddle.min_center => store.paddle.min_center
                __ => player_paddle - 1
            }
        }
        store.elements.down_button.event.press |> THEN {
            player_paddle |> WHEN {
                store.paddle.max_center => store.paddle.max_center
                __ => player_paddle + 1
            }
        }
        store.elements.restart_button.event.press |> THEN { store.paddle.start_center }
    }

    ball_x: -1 |> HOLD ball_x {
        store.elements.serve_button.event.press |> THEN { store.serve.x }
        store.elements.restart_button.event.press |> THEN { -1 }
        store.elements.tick_button.event.press |> THEN {
            idle_ball(ball_x: ball_x, ball_y: store.ball_y) |> WHEN {
                True => -1
                False => point_scored(ball_x: ball_x, ball_dx: store.ball_dx, ball_y: store.ball_y, ai_paddle: store.ai_paddle, player_paddle: store.player_paddle) |> WHEN {
                    True => -1
                    False => ball_x + next_ball_dx(ball_x: ball_x, ball_dx: store.ball_dx, ball_y: store.ball_y, ai_paddle: store.ai_paddle, player_paddle: store.player_paddle)
                }
            }
        }
    }

    ball_y: -1 |> HOLD ball_y {
        store.elements.serve_button.event.press |> THEN { store.serve.y }
        store.elements.restart_button.event.press |> THEN { -1 }
        store.elements.tick_button.event.press |> THEN {
            idle_ball(ball_x: store.ball_x, ball_y: ball_y) |> WHEN {
                True => -1
                False => point_scored(ball_x: store.ball_x, ball_dx: store.ball_dx, ball_y: ball_y, ai_paddle: store.ai_paddle, player_paddle: store.player_paddle) |> WHEN {
                    True => -1
                    False => ball_y + next_ball_dy(ball_y: ball_y, ball_dy: store.ball_dy)
                }
            }
        }
    }

    ball_dx: 1 |> HOLD ball_dx {
        store.elements.serve_button.event.press |> THEN { store.serve.dx }
        store.elements.restart_button.event.press |> THEN { store.serve.dx }
        store.elements.tick_button.event.press |> THEN {
            next_ball_dx(
                ball_x: store.ball_x
                ball_dx: ball_dx
                ball_y: store.ball_y
                ai_paddle: store.ai_paddle
                player_paddle: store.player_paddle
            )
        }
    }

    ball_dy: 1 |> HOLD ball_dy {
        store.elements.serve_button.event.press |> THEN { store.serve.dy }
        store.elements.restart_button.event.press |> THEN { store.serve.dy }
        store.elements.tick_button.event.press |> THEN { next_ball_dy(ball_y: store.ball_y, ball_dy: ball_dy) }
    }

    player_score: 0 |> HOLD player_score {
        store.elements.restart_button.event.press |> THEN { 0 }
        store.elements.tick_button.event.press |> THEN {
            store.player_scores_now |> WHEN {
                True => player_score + 1
                False => player_score
            }
        }
    }

    ai_score: 0 |> HOLD ai_score {
        store.elements.restart_button.event.press |> THEN { 0 }
        store.elements.tick_button.event.press |> THEN {
            store.ai_scores_now |> WHEN {
                True => ai_score + 1
                False => ai_score
            }
        }
    }

    --- derived ---

    ai_paddle: cpu_paddle(ball_y: store.ball_y, ball_x: store.ball_x)
    player_scores_now: player_scores(ball_x: store.ball_x, ball_dx: store.ball_dx, ball_y: store.ball_y, ai_paddle: ai_paddle)
    ai_scores_now: ai_scores(ball_x: store.ball_x, ball_dx: store.ball_dx, ball_y: store.ball_y, player_paddle: store.player_paddle)
    rally_active: idle_ball(ball_x: store.ball_x, ball_y: store.ball_y) |> Bool/not()
    status: rally_active |> WHEN {
        True => TEXT { Rally }
        False => TEXT { Press Enter }
    }
]

FUNCTION moving_left(ball_dx) {
    ball_dx == -1
}

FUNCTION moving_right(ball_dx) {
    ball_dx == 1
}

FUNCTION idle_ball(ball_x, ball_y) {
    ball_x == -1 |> Bool/or(that: ball_y == -1)
}

FUNCTION left_paddle_zone(ball_x) {
    ball_x == store.board.left_goal_x |> Bool/or(that: ball_x == store.board.left_paddle_x)
}

FUNCTION right_paddle_zone(ball_x) {
    ball_x == store.board.right_paddle_x |> Bool/or(that: ball_x == store.board.right_goal_x)
}

FUNCTION paddle_hits(ball_y, paddle) {
    ball_y == paddle |> Bool/or(that: ball_y + 1 == paddle) |> Bool/or(that: ball_y == paddle + 1)
}

FUNCTION cpu_paddle(ball_y, ball_x) {
    idle_ball(ball_x: ball_x, ball_y: ball_y) |> WHEN {
        True => store.paddle.start_center
        False => ball_y |> WHEN {
            store.board.top_row => store.paddle.min_center
            store.board.bottom_row => store.paddle.max_center
            __ => ball_y
        }
    }
}

FUNCTION hits_ai_paddle(ball_x, ball_dx, ball_y, ai_paddle) {
    moving_left(ball_dx: ball_dx)
    |> Bool/and(that: left_paddle_zone(ball_x: ball_x))
    |> Bool/and(that: paddle_hits(ball_y: ball_y, paddle: ai_paddle))
}

FUNCTION hits_player_paddle(ball_x, ball_dx, ball_y, player_paddle) {
    moving_right(ball_dx: ball_dx)
    |> Bool/and(that: right_paddle_zone(ball_x: ball_x))
    |> Bool/and(that: paddle_hits(ball_y: ball_y, paddle: player_paddle))
}

FUNCTION ai_scores(ball_x, ball_dx, ball_y, player_paddle) {
    ball_x == store.board.right_goal_x
    |> Bool/and(that: moving_right(ball_dx: ball_dx))
    |> Bool/and(that: hits_player_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle) |> Bool/not())
}

FUNCTION player_scores(ball_x, ball_dx, ball_y, ai_paddle) {
    ball_x == store.board.left_goal_x
    |> Bool/and(that: moving_left(ball_dx: ball_dx))
    |> Bool/and(that: hits_ai_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle) |> Bool/not())
}

FUNCTION point_scored(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    player_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle)
    |> Bool/or(that: ai_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle))
}

FUNCTION next_ball_dx(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    hits_ai_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle) |> WHEN {
        True => 1
        False => hits_player_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle) |> WHEN {
            True => -1
            False => ball_dx
        }
    }
}

FUNCTION next_ball_dy(ball_y, ball_dy) {
    ball_dy |> WHEN {
        -1 => ball_y == store.board.top_row |> WHEN {
            True => 1
            False => -1
        }
        __ => ball_y == store.board.bottom_row |> WHEN {
            True => -1
            False => 1
        }
    }
}

FUNCTION track_mark(ball_x, column) {
    ball_x == column |> WHEN {
        True => TEXT { o }
        False => TEXT { . }
    }
}

FUNCTION track_range(ball_x, from, to) {
    from == to |> WHEN {
        True => track_mark(ball_x: ball_x, column: from)
        False => BLOCK {
            head: track_mark(ball_x: ball_x, column: from)
            tail: track_range(ball_x: ball_x, from: from + 1, to: to)

            TEXT { {head}{tail} }
        }
    }
}

FUNCTION center_track(ball_x) {
    ball_x == store.serve.x |> WHEN {
        True => BLOCK {
            left: track_range(ball_x: ball_x, from: store.board.left_goal_x, to: store.serve.x - 1)
            right: track_range(ball_x: ball_x, from: store.serve.x + 1, to: store.board.right_goal_x)

            TEXT { {left}o{right} }
        }
        False => BLOCK {
            left: track_range(ball_x: ball_x, from: store.board.left_goal_x, to: store.serve.x - 1)
            right: track_range(ball_x: ball_x, from: store.serve.x + 1, to: store.board.right_goal_x)

            TEXT { {left}.{right} }
        }
    }
}

FUNCTION paddle_segment(row, paddle) {
    paddle_hits(ball_y: row, paddle: paddle) |> WHEN {
        True => TEXT { [] }
        False => TEXT { .. }
    }
}

FUNCTION court_row(row, ai_paddle, player_paddle, ball_x, ball_y) {
    BLOCK {
        left_paddle: paddle_segment(row: row, paddle: ai_paddle)
        right_paddle: paddle_segment(row: row, paddle: player_paddle)
        center: ball_y == row |> WHEN {
            True => center_track(ball_x: ball_x)
            False => center_track(ball_x: -1)
        }

        TEXT { #{left_paddle}{center}{right_paddle}# }
    }
}

document: Document/new(root: Element/stripe(
    element: []
    direction: Column
    gap: 0
    style: []

    items: LIST {
        Element/label(element: [], style: [], label: TEXT { PONG })
        Element/stripe(
            element: []
            direction: Row
            gap: 2
            style: []

            items: LIST {
                Element/label(element: [], style: [], label: TEXT { YOU })
                Element/label(element: [], style: [], label: store.player_score)
                Element/label(element: [], style: [], label: TEXT { CPU })
                Element/label(element: [], style: [], label: store.ai_score)
                Element/label(element: [], style: [], label: TEXT { STATUS })
                Element/label(element: [], style: [], label: store.status)
            }
        )
        Element/label(element: [], style: [], label: TEXT { # } |> Text/repeat(times: store.border_width))
        Element/stripe(
            element: []
            direction: Column
            gap: 0
            style: []
            items: List/range(from: store.board.top_row, to: store.board.bottom_row)
            |> List/map(row, new:
                Element/label(
                    element: []
                    style: []
                    label: court_row(
                        row: row
                        ai_paddle: store.ai_paddle
                        player_paddle: store.player_paddle
                        ball_x: store.ball_x
                        ball_y: store.ball_y
                    )
                )
            )
        )
        Element/label(element: [], style: [], label: TEXT { # } |> Text/repeat(times: store.border_width))
        Element/stripe(
            element: []
            direction: Row
            gap: 2
            style: []

            items: LIST {
                button(label: TEXT { Up }) |> LINK { store.elements.up_button }
                button(label: TEXT { Down }) |> LINK { store.elements.down_button }
                button(label: TEXT { Serve }) |> LINK { store.elements.serve_button }
                button(label: TEXT { Tick }) |> LINK { store.elements.tick_button }
                button(label: TEXT { Restart }) |> LINK { store.elements.restart_button }
            }
        )
    }
))

FUNCTION button(label) {
    Element/button(
        element: [event: [press: LINK]]
        style: []
        label: label
    )
}
