board: [
    top_row: 0
    bottom_row: 6
    left_goal_x: 0
    right_goal_x: 16
    left_paddle_x: 1
    right_paddle_x: 15
]

paddle: [
    min_center: 1
    max_center: 5
    start_center: 3
]

serve: [
    x: 8
    y: 3
    dx: 1
    dy: 1
]

border_width: board.right_goal_x + 7

FUNCTION clamp_up(value) {
    value |> WHEN {
        paddle.min_center => paddle.min_center
        __ => value - 1
    }
}

FUNCTION clamp_down(value) {
    value |> WHEN {
        paddle.max_center => paddle.max_center
        __ => value + 1
    }
}

FUNCTION clamp_paddle_center(value) {
    value |> WHEN {
        board.top_row => paddle.min_center
        board.bottom_row => paddle.max_center
        __ => value
    }
}

FUNCTION moving_left(ball_dx) {
    ball_dx == -1
}

FUNCTION moving_right(ball_dx) {
    ball_dx == 1
}

FUNCTION idle_ball(ball_x, ball_y) {
    ball_x == -1 |> Bool/or(that: ball_y == -1)
}

FUNCTION left_paddle_zone(ball_x) {
    ball_x == board.left_goal_x |> Bool/or(that: ball_x == board.left_paddle_x)
}

FUNCTION right_paddle_zone(ball_x) {
    ball_x == board.right_paddle_x |> Bool/or(that: ball_x == board.right_goal_x)
}

FUNCTION paddle_hits(ball_y, paddle) {
    ball_y == paddle |> Bool/or(that: ball_y + 1 == paddle) |> Bool/or(that: ball_y == paddle + 1)
}

FUNCTION cpu_paddle(ball_y, ball_x) {
    idle_ball(ball_x: ball_x, ball_y: ball_y) |> WHEN {
        True => paddle.start_center
        False => clamp_paddle_center(value: ball_y)
    }
}

FUNCTION hits_ai_paddle(ball_x, ball_dx, ball_y, ai_paddle) {
    moving_left(ball_dx: ball_dx)
    |> Bool/and(that: left_paddle_zone(ball_x: ball_x))
    |> Bool/and(that: paddle_hits(ball_y: ball_y, paddle: ai_paddle))
}

FUNCTION hits_player_paddle(ball_x, ball_dx, ball_y, player_paddle) {
    moving_right(ball_dx: ball_dx)
    |> Bool/and(that: right_paddle_zone(ball_x: ball_x))
    |> Bool/and(that: paddle_hits(ball_y: ball_y, paddle: player_paddle))
}

FUNCTION ai_scores(ball_x, ball_dx, ball_y, player_paddle) {
    ball_x == board.right_goal_x
    |> Bool/and(that: moving_right(ball_dx: ball_dx))
    |> Bool/and(that: hits_player_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle) |> Bool/not())
}

FUNCTION player_scores(ball_x, ball_dx, ball_y, ai_paddle) {
    ball_x == board.left_goal_x
    |> Bool/and(that: moving_left(ball_dx: ball_dx))
    |> Bool/and(that: hits_ai_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle) |> Bool/not())
}

FUNCTION point_scored(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    player_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle)
    |> Bool/or(that: ai_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle))
}

FUNCTION next_ball_dx(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    hits_ai_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle) |> WHEN {
        True => 1
        False => hits_player_paddle(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle) |> WHEN {
            True => -1
            False => ball_dx
        }
    }
}

FUNCTION next_ball_dy(ball_y, ball_dy) {
    ball_dy |> WHEN {
        -1 => ball_y == board.top_row |> WHEN {
            True => 1
            False => -1
        }
        __ => ball_y == board.bottom_row |> WHEN {
            True => -1
            False => 1
        }
    }
}

FUNCTION rally_continues(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    point_scored(
        ball_x: ball_x
        ball_dx: ball_dx
        ball_y: ball_y
        ai_paddle: ai_paddle
        player_paddle: player_paddle
    )
    |> Bool/not()
}

FUNCTION next_ball_x(ball_x, ball_dx, ball_y, ai_paddle, player_paddle) {
    idle_ball(ball_x: ball_x, ball_y: ball_y) |> WHEN {
        True => -1
        False => rally_continues(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle, player_paddle: player_paddle) |> WHEN {
                True => ball_x + next_ball_dx(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle, player_paddle: player_paddle)
                False => -1
            }
    }
}

FUNCTION next_ball_y(ball_x, ball_dx, ball_y, ball_dy, ai_paddle, player_paddle) {
    idle_ball(ball_x: ball_x, ball_y: ball_y) |> WHEN {
        True => -1
        False => rally_continues(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle, player_paddle: player_paddle) |> WHEN {
                True => ball_y + next_ball_dy(ball_y: ball_y, ball_dy: ball_dy)
                False => -1
            }
    }
}

FUNCTION next_player_score(score, ball_x, ball_dx, ball_y, ai_paddle) {
    player_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle) |> WHEN {
        True => score + 1
        False => score
    }
}

FUNCTION next_ai_score(score, ball_x, ball_dx, ball_y, player_paddle) {
    ai_scores(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle) |> WHEN {
        True => score + 1
        False => score
    }
}

FUNCTION track_mark(ball_x, column) {
    ball_x == column |> WHEN {
        True => TEXT { o }
        False => TEXT { . }
    }
}

FUNCTION track_range(ball_x, from, to) {
    from == to |> WHEN {
        True => track_mark(ball_x: ball_x, column: from)
        False => TEXT {
            {track_mark(ball_x: ball_x, column: from)}
            {track_range(ball_x: ball_x, from: from + 1, to: to)}
        }
    }
}

FUNCTION center_track(ball_x) {
    ball_x == serve.x |> WHEN {
        True => TEXT {
            {track_range(ball_x: ball_x, from: board.left_goal_x, to: serve.x - 1)}
            o
            {track_range(ball_x: ball_x, from: serve.x + 1, to: board.right_goal_x)}
        }
        False => TEXT {
            {track_range(ball_x: ball_x, from: board.left_goal_x, to: serve.x - 1)}
            .
            {track_range(ball_x: ball_x, from: serve.x + 1, to: board.right_goal_x)}
        }
    }
}

FUNCTION paddle_segment(row, paddle) {
    paddle_hits(ball_y: row, paddle: paddle) |> WHEN {
        True => TEXT { [] }
        False => TEXT { .. }
    }
}

FUNCTION court_row(row, ai_paddle, player_paddle, ball_x, ball_y) {
    BLOCK {
        left_paddle: paddle_segment(row: row, paddle: ai_paddle)
        right_paddle: paddle_segment(row: row, paddle: player_paddle)
        center: ball_y == row |> WHEN {
            True => center_track(ball_x: ball_x)
            False => center_track(ball_x: -1)
        }

        TEXT { #{left_paddle}{center}{right_paddle}# }
    }
}

FUNCTION repeat_text(text, times) {
    times == 1 |> WHEN {
        True => text
        False => TEXT { {text}{repeat_text(text: text, times: times - 1)} }
    }
}

FUNCTION border_row() {
    repeat_text(text: TEXT { # }, times: border_width)
}

FUNCTION text_row(text) {
    Element/label(element: [], style: [], label: text)
}

FUNCTION court_row_element(row, ai_paddle, player_paddle, ball_x, ball_y) {
    text_row(text: court_row(
        row: row
        ai_paddle: ai_paddle
        player_paddle: player_paddle
        ball_x: ball_x
        ball_y: ball_y
    ))
}

FUNCTION court_rows(ai_paddle, player_paddle, ball_x, ball_y) {
    List/range(from: board.top_row, to: board.bottom_row)
    |> List/map(row, new:
        court_row_element(
            row: row
            ai_paddle: ai_paddle
            player_paddle: player_paddle
            ball_x: ball_x
            ball_y: ball_y
        )
    )
}

FUNCTION court_element(ai_paddle, player_paddle, ball_x, ball_y) {
    Element/stripe(
        element: []
        direction: Column
        gap: 0
        style: []
        items: court_rows(
            ai_paddle: ai_paddle
            player_paddle: player_paddle
            ball_x: ball_x
            ball_y: ball_y
        )
    )
}

store: [
    elements: [
        up_button: LINK
        down_button: LINK
        serve_button: LINK
        restart_button: LINK
        tick_button: LINK
    ]
]

up_button: Element/button(
    element: [event: [press: store.elements.up_button]]
    style: []
    label: TEXT { Up }
)

down_button: Element/button(
    element: [event: [press: store.elements.down_button]]
    style: []
    label: TEXT { Down }
)

serve_button: Element/button(
    element: [event: [press: store.elements.serve_button]]
    style: []
    label: TEXT { Serve }
)

restart_button: Element/button(
    element: [event: [press: store.elements.restart_button]]
    style: []
    label: TEXT { Restart }
)

tick_button: Element/button(
    element: [event: [press: store.elements.tick_button]]
    style: []
    label: TEXT { Tick }
)

player_paddle: paddle.start_center |> HOLD player_paddle {
    store.elements.up_button.event.press |> THEN { clamp_up(value: player_paddle) }
    store.elements.down_button.event.press |> THEN { clamp_down(value: player_paddle) }
    store.elements.restart_button.event.press |> THEN { paddle.start_center }
}

ai_paddle: cpu_paddle(ball_y: ball_y, ball_x: ball_x)

ball_x: -1 |> HOLD ball_x {
    store.elements.serve_button.event.press |> THEN { serve.x }
    store.elements.restart_button.event.press |> THEN { -1 }
    store.elements.tick_button.event.press |> THEN {
        next_ball_x(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle, player_paddle: player_paddle)
    }
}

ball_y: -1 |> HOLD ball_y {
    store.elements.serve_button.event.press |> THEN { serve.y }
    store.elements.restart_button.event.press |> THEN { -1 }
    store.elements.tick_button.event.press |> THEN {
        next_ball_y(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ball_dy: ball_dy, ai_paddle: ai_paddle, player_paddle: player_paddle)
    }
}

ball_dx: 1 |> HOLD ball_dx {
    store.elements.serve_button.event.press |> THEN { serve.dx }
    store.elements.restart_button.event.press |> THEN { serve.dx }
    store.elements.tick_button.event.press |> THEN { next_ball_dx(ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle, player_paddle: player_paddle) }
}

ball_dy: 1 |> HOLD ball_dy {
    store.elements.serve_button.event.press |> THEN { serve.dy }
    store.elements.restart_button.event.press |> THEN { serve.dy }
    store.elements.tick_button.event.press |> THEN { next_ball_dy(ball_y: ball_y, ball_dy: ball_dy) }
}

player_score: 0 |> HOLD player_score {
    store.elements.restart_button.event.press |> THEN { 0 }
    store.elements.tick_button.event.press |> THEN {
        next_player_score(score: player_score, ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, ai_paddle: ai_paddle)
    }
}

ai_score: 0 |> HOLD ai_score {
    store.elements.restart_button.event.press |> THEN { 0 }
    store.elements.tick_button.event.press |> THEN {
        next_ai_score(score: ai_score, ball_x: ball_x, ball_dx: ball_dx, ball_y: ball_y, player_paddle: player_paddle)
    }
}

status: idle_ball(ball_x: ball_x, ball_y: ball_y) |> WHEN {
    True => TEXT { Press Enter }
    False => TEXT { Rally }
}

FUNCTION hud_row() {
    Element/stripe(
        element: []
        direction: Row
        gap: 2
        style: []

        items: LIST {
            Element/label(element: [], style: [], label: TEXT { YOU })
            Element/label(element: [], style: [], label: player_score)
            Element/label(element: [], style: [], label: TEXT { CPU })
            Element/label(element: [], style: [], label: ai_score)
            Element/label(element: [], style: [], label: TEXT { STATUS })
            Element/label(element: [], style: [], label: status)
        }
    )
}

FUNCTION controls_row() {
    Element/stripe(
        element: []
        direction: Row
        gap: 2
        style: []

        items: LIST {
            up_button
            down_button
            serve_button
            tick_button
            restart_button
        }
    )
}

document: Document/new(root: Element/stripe(
    element: []
    direction: Column
    gap: 0
    style: []

    items: LIST {
        text_row(text: TEXT { PONG })
        hud_row()
        text_row(text: border_row())
        court_element(ai_paddle: ai_paddle, player_paddle: player_paddle, ball_x: ball_x, ball_y: ball_y)
        text_row(text: border_row())
        controls_row()
    }
))
