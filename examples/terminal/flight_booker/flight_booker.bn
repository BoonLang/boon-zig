-- Flight Booker (7GUIs Task 3)
-- Select flight type, enter dates, validate, book.

store: [
    elements: [
        flight_select: SOURCE
        one_way_button: SOURCE
        return_button: SOURCE
        departure_input: [event: [change: SOURCE]]
        return_input: [event: [change: SOURCE]]
        book_button: SOURCE
    ]

    flight_type: TEXT { one-way } |> HOLD state {
        LATEST {
            elements.flight_select.event.change |> THEN { elements.flight_select.event.change.value }
            elements.one_way_button.event.press |> THEN { TEXT { one-way } }
            elements.return_button.event.press |> THEN { TEXT { return } }
        }
    }

    departure_date: TEXT { 2026-03-03 } |> HOLD state {
        elements.departure_input.event.change |> THEN { elements.departure_input.event.change.text }
    }

    return_date: TEXT { 2026-03-03 } |> HOLD state {
        elements.return_input.event.change |> THEN { elements.return_input.event.change.text }
    }

    is_return: flight_type |> WHILE {
        TEXT { return } => True
        __ => False
    }

    is_valid: is_return |> WHILE {
        False => True
        True => return_date >= departure_date
    }

    booked: TEXT { } |> HOLD state {
        elements.book_button.event.press |> THEN {
            is_return |> WHEN {
                False => TEXT { Booked one-way flight on {departure_date} }
                True => TEXT { Booked return flight: {departure_date} to {return_date} }
            }
        }
    }
]

terminal: Terminal/new(root: root_element(PASS: [store: store]), loop: None)

FUNCTION root_element() {
    BLOCK {
        store: PASSED.store
        departure_date: store.departure_date
        return_date: store.return_date
        is_return: store.is_return
        is_valid: store.is_valid
        booked: store.booked

        Element/stripe(
            element: [
                terminal: [
                    bindings: LIST {
                        [
                            keys: LIST { TEXT { r } }
                            link: store.elements.return_button
                            label: TEXT { return flight }
                        ]
                        [
                            keys: LIST { TEXT { o } }
                            link: store.elements.one_way_button
                            label: TEXT { one-way flight }
                        ]
                        [
                            keys: LIST { TEXT { b } }
                            link: store.elements.book_button
                            label: TEXT { book }
                        ]
                    }
                ]
            ]
            direction: Column
            gap: 12
            style: [padding: 20, width: 300]

            items: LIST {
                Element/label(
                    element: []
                    style: [font: [size: 22, weight: Bold]]
                    label: TEXT { Flight Booker }
                )
                Element/select(
                    element: [event: [change: SOURCE]]
                    style: [width: Fill]
                    label: Hidden[text: TEXT { Flight type }]
                    options: LIST {
                        [value: TEXT { one-way }, label: TEXT { One-way flight }]
                        [value: TEXT { return }, label: TEXT { Return flight }]
                    }
                    selected: store.flight_type
                ) |> SOURCE { store.elements.flight_select }
                Element/stripe(
                    element: []
                    direction: Row
                    gap: 8
                    style: []
                    items: LIST {
                        Element/button(element: [event: [press: SOURCE]], style: [], label: TEXT { One-way }) |> SOURCE { store.elements.one_way_button }
                        Element/button(element: [event: [press: SOURCE]], style: [], label: TEXT { Return }) |> SOURCE { store.elements.return_button }
                    }
                )
                Element/text_input(
                    element: store.elements.departure_input
                    style: [width: Fill]
                    label: Hidden[text: TEXT { Departure date }]
                    text: departure_date
                    placeholder: [text: TEXT { YYYY-MM-DD }]
                    focus: False
                )
                Element/text_input(
                    element: store.elements.return_input
                    style: [
                        width: Fill
                        disabled: is_return |> WHILE {
                            True => False
                            __ => True
                        }
                    ]
                    label: Hidden[text: TEXT { Return date }]
                    text: return_date
                    placeholder: [text: TEXT { YYYY-MM-DD }]
                    focus: False
                )
                Element/button(
                    element: [event: [press: SOURCE]]
                    style: [
                        width: Fill
                        disabled: is_valid |> WHILE {
                            True => False
                            __ => True
                        }
                    ]
                    label: TEXT { Book }
                ) |> SOURCE { store.elements.book_button }
                Element/label(
                    element: []
                    style: []
                    label: booked
                )
            }
        )
    }
}
