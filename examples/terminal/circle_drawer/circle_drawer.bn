-- Circle Drawer (7GUIs Task 6) terminal projection.
-- The terminal host has no drawable pointer canvas, so "Canvas click"
-- represents one click on the drawing surface and Undo removes the last one.

store: [
    elements: [
        canvas_click_button: SOURCE
        undo_button: SOURCE
    ]

    circles: LIST {}
        |> List/append(on: elements.canvas_click_button.event.press |> THEN { [x: 20, y: 20] })
        |> List/remove_last(on: elements.undo_button.event.press)

    count: circles |> List/count()
]

terminal: Terminal/new(root: root_element(PASS: [store: store]), loop: None)

FUNCTION root_element() {
    BLOCK {
        store: PASSED.store

        Element/stripe(
            element: [
                terminal: [
                    bindings: LIST {
                        [
                            keys: LIST { TEXT { c } }
                            link: store.elements.canvas_click_button
                            label: TEXT { canvas click }
                        ]
                        [
                            keys: LIST { TEXT { u } }
                            link: store.elements.undo_button
                            label: TEXT { undo }
                        ]
                    }
                ]
            ]
            direction: Column
            gap: 12
            style: [padding: 20, width: 500]

            items: LIST {
                Element/label(
                    element: []
                    style: [font: [size: 22, weight: Bold]]
                    label: TEXT { Circle Drawer }
                )
                Element/stripe(
                    element: []
                    direction: Row
                    gap: 10
                    style: []
                    items: LIST {
                        Element/button(
                            element: [event: [press: SOURCE]]
                            style: []
                            label: TEXT { Canvas click }
                        ) |> SOURCE { store.elements.canvas_click_button }
                        Element/button(
                            element: [event: [press: SOURCE]]
                            style: []
                            label: TEXT { Undo }
                        ) |> SOURCE { store.elements.undo_button }
                        Element/label(
                            element: []
                            style: []
                            label: TEXT { Circles: {store.count} }
                        )
                    }
                )
            }
        )
    }
}
