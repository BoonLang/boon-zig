store: [
    ------ links ------

    elements: [
        left_button: SOURCE
        right_button: SOURCE
        launch_button: SOURCE
        tick_button: SOURCE
    ]

    ------ states ------

    paddle: 0 |> HOLD paddle {
        store.elements.left_button.event.press |> THEN {
            paddle |> WHEN {
                0 => 0
                __ => paddle - 1
            }
        }

        store.elements.right_button.event.press |> THEN {
            paddle |> WHEN {
                4 => 4
                __ => paddle + 1
            }
        }
    }

    ball: -1 |> HOLD ball {
        store.elements.launch_button.event.press |> THEN { 0 }

        store.elements.tick_button.event.press |> THEN {
            ball |> WHEN {
                -1 => -1

                __ => ball == store.paddle |> WHEN {
                    True => -1

                    False => ball == 4 |> WHEN {
                        True => -1
                        False => ball + 1
                    }
                }
            }
        }
    }

    bricks: 3 |> HOLD bricks {
        store.elements.tick_button.event.press |> THEN {
            store.ball |> WHEN {
                -1 => bricks

                __ => store.ball == store.paddle |> WHEN {
                    True => bricks |> WHEN {
                        0 => 0
                        __ => bricks - 1
                    }

                    False => bricks
                }
            }
        }
    }

    ------ derived ------

    status: store.bricks == 0 |> WHEN {
        True => TEXT { Cleared }

        False => store.ball |> WHEN {
            -1 => TEXT { Ready }
            __ => TEXT { Flight }
        }
    }
]

------ terminal ------

terminal: Terminal/new(
    root: Element/stripe(
        element: [
            terminal: [
                bindings: LIST {
                    [
                        keys: LIST {
                            TEXT { Left }
                            TEXT { a }
                        }

                        link: store.elements.left_button
                        label: TEXT { left }
                    ]

                    [
                        keys: LIST {
                            TEXT { Right }
                            TEXT { d }
                        }

                        link: store.elements.right_button
                        label: TEXT { right }
                    ]

                    [
                        keys: LIST {
                            TEXT { Enter }
                        }

                        link: store.elements.launch_button
                        when: store.ball == -1
                        label: TEXT { launch }
                    ]

                    [
                        keys: LIST {
                            TEXT { Space }
                        }

                        link: store.elements.tick_button
                        label: TEXT { tick }
                    ]
                }
            ]
        ]

        direction: Column
        gap: 0
        style: []

        items: LIST {
            Element/label(element: [], style: [], label: TEXT { Arkanoid })
            board_view()
            Element/label(element: [], style: [], label: TEXT { Bricks:{store.bricks} })
            Element/label(element: [], style: [], label: TEXT { Paddle:{store.paddle} })
            Element/label(element: [], style: [], label: TEXT { Ball:{store.ball} })
            Element/label(element: [], style: [], label: store.status)
        }
    )

    loop: [
        pulse: store.elements.tick_button
        while: store.ball == -1 |> Bool/not()
        every: Duration [milliseconds: 180]
    ]
)

------ board ------

FUNCTION board_view() {
    Element/stripe(
        element: []
        direction: Column
        gap: 0
        style: []

        items: LIST {
            Element/label(element: [], style: [], label: TEXT { ###### })
            Element/label(element: [], style: [], label: bricks_display())
            Element/label(element: [], style: [], label: ball_display())
            Element/label(element: [], style: [], label: paddle_display())
            Element/label(element: [], style: [], label: TEXT { ###### })
        }
    )
}

------ board helpers ------

FUNCTION bricks_display() {
    store.bricks |> WHEN {
        0 => TEXT { ...... }
        1 => TEXT { #..... }
        2 => TEXT { ##.... }
        __ => TEXT { ###... }
    }
}

FUNCTION ball_display() {
    store.ball |> WHEN {
        -1 => TEXT { ...... }
        0 => TEXT { o..... }
        1 => TEXT { .o.... }
        2 => TEXT { ..o... }
        3 => TEXT { ...o.. }
        __ => TEXT { ....o. }
    }
}

FUNCTION paddle_display() {
    store.paddle |> WHEN {
        0 => TEXT { p..... }
        1 => TEXT { .p.... }
        2 => TEXT { ..p... }
        3 => TEXT { ...p.. }
        __ => TEXT { ....p. }
    }
}
